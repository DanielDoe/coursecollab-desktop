# Vite renderer
VITE_API_URL=https://course-collab.com
# Local API during development (optional — run npm run dev:api in another terminal):
# VITE_API_URL=http://localhost:3000

VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# Desktop over-the-air updates (electron-builder --publish always)
# GH_TOKEN=github_pat_...
# Optional generic feed instead of GitHub Releases:
# DESKTOP_UPDATE_FEED_URL=https://example.com/desktop-updates

# macOS Developer ID signing + notarization (electron-builder mac.notarize)
# Prefer App Store Connect API key (Team Key with Developer access):
# APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_TEAM_ID=5S94RUARQ4
#
# Or Apple ID + app-specific password (https://appleid.apple.com → App-Specific Passwords):
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=5S94RUARQ4
